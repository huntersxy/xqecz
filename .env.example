# ── MySQL ──
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=xqecz
# 连接池上限（默认 10）。调得过小会在并发下排队：实测 20 并发 × 每请求 3 次查询时，
# 池 5 → p50 616ms / 墙钟 1178ms，池 30 → p50 304ms / 墙钟 339ms。
MYSQL_POOL_SIZE=30
# 建连超时（秒），同时用作连接最长存活时间的换算基准
MYSQL_CONNECT_TIMEOUT=10
# 连接加密模式（透传给驱动的 tls 参数），留空 = 不加密。
# TiDB Cloud 等托管实例强制加密（明文连接报 1105 insecure transport），此时设为 true。
MYSQL_TLS=

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# 业务 key 统一前缀（与旧 ioredis keyPrefix 语义一致）
REDIS_PREFIX=xqecz:

# ── 服务 ──
PORT=3000
# 允许的前端来源，逗号分隔；只允许凭据请求，未命中的来源不回 ACAO。
# 两种写法：精确 origin（https://example.com）或子域通配（*.edgeone.cool，
# 也支持带协议 https://*.edgeone.cool）。通配只匹配子域、不匹配裸域本身，
# 用于平台按项目动态分配的调试/预览域名；删掉条目即回到精确白名单。
CORS_ORIGINS=http://localhost:5173
# production 时 gin 走 release 模式
APP_ENV=development
# 留空则使用项目根 data/ 下的 uploads、thumbs、images、bin 四个同级目录
UPLOAD_DIR=
THUMB_DIR=
IMAGES_DIR=
# 压缩/清理后原图的垃圾桶目录（保留而非删除，便于回溯）
BIN_DIR=

# ── TinyPNG 后台压缩 ──
# API Key 留空则压缩任务自动休眠（本地开发无需配额）
TINIFY_API_KEY=
# 小于该体积（KB）的图片不压缩
COMPRESS_MIN_KB=400
# 压缩任务间隔（秒），每轮只处理一张最大的待压缩图片
COMPRESS_INTERVAL_SECONDS=60

# ── Cloudflare R2 镜像（原图 + 压缩图各留一份，缩略图纯本地）──
# 四项凭据任一为空即整体停用（任务静默休眠，与 TINIFY_API_KEY 同样的策略）。
# 镜像为 append-only：内容删除时本地文件进垃圾桶、R2 对象不删。
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# 桶内公共前缀（默认 uploads，与本地目录同名，便于对账；置空则直接用相对路径）
R2_PREFIX=uploads
# S3 端点，留空则按 R2_ACCOUNT_ID 推导为 https://<account>.r2.cloudflarestorage.com
R2_ENDPOINT=
# 对象的公开访问基址（自定义域名或 r2.dev）。留空 = 只镜像、不给前端备用源；
# 填了才会把 R2 地址下发给详情页作为首选来源。
R2_PUBLIC_BASE=
# 回填任务间隔（秒）：启动即跑一轮补齐存量，之后按此周期兜住偶发失败
R2_SYNC_INTERVAL_SECONDS=300
# 单次上传超时（秒）
R2_UPLOAD_TIMEOUT_SECONDS=120

# ── 七牛云镜像（一级替补：R2 不可达时用它，它也不可用才回源站）──
# 凭据不全即整体停用；桶/区域任一为空都算未配置。
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
# 存储区域，决定 S3 端点，如 cn-south-1（华南-广东）
QINIU_REGION=
# S3 端点，留空则按 QINIU_REGION 推导为 https://s3.<region>.qiniucs.com
QINIU_ENDPOINT=
# 该桶绑定的 CDN 加速域名（推送走 S3 端点、取图走这里，两者不同，不要混填）
QINIU_PUBLIC_BASE=
# 桶内公共前缀（与 R2 同名，便于两侧对账）
QINIU_PREFIX=uploads
# 回填任务间隔（秒）：每个目标各一个任务、各持一把锁，互不阻塞
QINIU_SYNC_INTERVAL_SECONDS=300
QINIU_UPLOAD_TIMEOUT_SECONDS=120
# 免费额度检查间隔（秒）与触顶比例：任一项达到比例即整层停用，次月自动恢复
# 统计数据本身有约 5 分钟延迟，间隔显著大于它才有意义
QINIU_QUOTA_INTERVAL_SECONDS=600
QINIU_QUOTA_THRESHOLD=0.9
# 外网流出（S3 直连）的自设上限，单位 GB。该项七牛**没有免费额度**（0.26 元/GB），
# 只能自己划线；0 = 不判定（桶保持私有时该路径走不通，也就没有这笔开销）
QINIU_EGRESS_CAP_GB=0
# 时间戳防盗链密钥。**留空即不签名**——控制台开启该功能后必须在此填入主密钥，
# 否则下发的地址一律 403。注意它与证书自动续签互斥（开启后 ACME 校验会被挡）。
QINIU_TIME_KEY=

# ── 前端（VITE_ 前缀由 Vite 注入客户端）──
VITE_API_BASE_URL=/api
VITE_MEDIA_BASE_URL=
