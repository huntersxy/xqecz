# ── MySQL ──
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=xqecz
# 连接池上限（默认 10）。调得过小会在并发下排队：实测 20 并发 × 每请求 3 次查询时，
# 池 5 → p50 616ms / 墙钟 1178ms，池 30 → p50 304ms / 墙钟 339ms。
MYSQL_POOL_SIZE=30
# 建连超时（秒），同时用作连接最长存活时间的换算基准
MYSQL_CONNECT_TIMEOUT=10
# 连接加密模式（透传给驱动的 tls 参数），留空 = 不加密。
# TiDB Cloud 等托管实例强制加密（明文连接报 1105 insecure transport），此时设为 true。
MYSQL_TLS=

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# 业务 key 统一前缀（与旧 ioredis keyPrefix 语义一致）
REDIS_PREFIX=xqecz:

# ── 服务 ──
PORT=3000
# 允许的前端来源，逗号分隔；只允许凭据请求，未命中的来源不回 ACAO。
# 两种写法：精确 origin（https://example.com）或子域通配（*.edgeone.cool，
# 也支持带协议 https://*.edgeone.cool）。通配只匹配子域、不匹配裸域本身，
# 用于平台按项目动态分配的调试/预览域名；删掉条目即回到精确白名单。
CORS_ORIGINS=http://localhost:5173
# production 时 gin 走 release 模式
APP_ENV=development
# 留空则使用项目根 data/ 下的 uploads、thumbs、images、bin 四个同级目录
UPLOAD_DIR=
THUMB_DIR=
IMAGES_DIR=
# 压缩/清理后原图的垃圾桶目录（保留而非删除，便于回溯）
BIN_DIR=

# ── TinyPNG 后台压缩 ──
# API Key 留空则压缩任务自动休眠（本地开发无需配额）
TINIFY_API_KEY=
# 小于该体积（KB）的图片不压缩
COMPRESS_MIN_KB=400
# 压缩任务间隔（秒），每轮只处理一张最大的待压缩图片
COMPRESS_INTERVAL_SECONDS=60

# ── Cloudflare R2 镜像（原图 + 压缩图各留一份，缩略图纯本地）──
# 四项凭据任一为空即整体停用（任务静默休眠，与 TINIFY_API_KEY 同样的策略）。
# 镜像为 append-only：内容删除时本地文件进垃圾桶、R2 对象不删。
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# 桶内公共前缀（默认 uploads，与本地目录同名，便于对账；置空则直接用相对路径）
R2_PREFIX=uploads
# S3 端点，留空则按 R2_ACCOUNT_ID 推导为 https://<account>.r2.cloudflarestorage.com
R2_ENDPOINT=
# 对象的公开访问基址（自定义域名或 r2.dev）。留空 = 只镜像、不给前端备用源；
# 填了才会把 R2 地址下发给详情页（首选是自建 OpenList，这里是次选）。
R2_PUBLIC_BASE=
# 回填任务间隔（秒）：启动即跑一轮补齐存量，之后按此周期兜住偶发失败
R2_SYNC_INTERVAL_SECONDS=300
# 单次上传超时（秒）
R2_UPLOAD_TIMEOUT_SECONDS=120

# ── 自建 OpenList 镜像（一级首选：它不可达时才退 R2，再不行回源站）──
# 基址或 token 任一为空即整体停用（与 R2 同一策略），只留着 R2 那一路。
# 端点指向 OpenList 的入口，推送走 /api/fs/put。
# 生产用公开域名（如 https://drive.xiey.work）：实测经 CDN 回源比直连裸 IP 更快
# （20MB 上传 157Mbps vs 78Mbps），且无需在源站维护 IP 白名单。
# 调试可直连 http://127.0.0.1:5244（同机）或 http://<公网IP>:5244（异地）。
OPENLIST_ENDPOINT=
# OpenList 的 admin token（数据库 x_setting_items 的 token 项）。
# 注意：请求头是 `Authorization: <token>`，**不带 Bearer**，带了必被拒。
OPENLIST_TOKEN=
# 对象所在的存储挂载路径前缀（与 R2 同名，便于两侧对账）
OPENLIST_PREFIX=uploads
# 该实例对外提供下载的基址，**必须带免签直链前缀 /d**（如 https://drive.xiey.work/d）。
# 只写裸域名是错的：那在 OpenList 侧是 SPA 前端，未加前缀的路径一律回 index.html，
# 下发的 mirror2_* 会全部指向首页 HTML。
# 留空 = 只镜像、不给前端首选来源，前端会直接落到 R2。
# 免签直链要求实例侧 sign_all=false，否则 /d/ 会 401。
OPENLIST_PUBLIC_BASE=
# 回填任务间隔（秒）：每个目标各一个任务、各持一把锁，互不阻塞
OPENLIST_SYNC_INTERVAL_SECONDS=300
# 单次上传超时（秒）
OPENLIST_UPLOAD_TIMEOUT_SECONDS=120

# ── 前端（VITE_ 前缀由 Vite 注入客户端）──
VITE_API_BASE_URL=/api
VITE_MEDIA_BASE_URL=
