# ── MySQL ──
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=xqecz
# 连接池上限（默认 10）。调得过小会在并发下排队：实测 20 并发 × 每请求 3 次查询时，
# 池 5 → p50 616ms / 墙钟 1178ms，池 30 → p50 304ms / 墙钟 339ms。
MYSQL_POOL_SIZE=30
# 建连超时（秒），同时用作连接最长存活时间的换算基准
MYSQL_CONNECT_TIMEOUT=10

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# 业务 key 统一前缀（与旧 ioredis keyPrefix 语义一致）
REDIS_PREFIX=xqecz:

# ── 服务 ──
PORT=3000
CORS_ORIGINS=http://localhost:5173
# production 时 gin 走 release 模式
APP_ENV=development
# 留空则使用项目根 data/ 下的 uploads、thumbs、images 三个同级目录
UPLOAD_DIR=
THUMB_DIR=
IMAGES_DIR=

# ── 前端（VITE_ 前缀由 Vite 注入客户端）──
VITE_API_BASE_URL=/api
VITE_MEDIA_BASE_URL=
